<Window x:Class="NetworkSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkSharp"
        xmlns:views="clr-namespace:NetworkSharp.Views"
        mc:Ignorable="d"
        Title="Network# - NetworkSharp" Height="720" Width="1280" MinHeight="600" MinWidth="1000"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource BackgroundSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Logo/Title -->
                <Border Grid.Row="0" Padding="20" Background="#11111B">
                    <StackPanel>
                        <TextBlock Text="Network#" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                        <TextBlock Text="NetworkSharp" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NavigationItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="NavButton" 
                                        Click="NavButton_Click"
                                        Tag="{Binding Name}"
                                        Height="50" 
                                        Margin="8,4"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="16,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Icon placeholder - would use proper icons in production -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Icon}" 
                                                   FontSize="18" 
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"/>
                                        
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding DisplayName}" 
                                                   FontSize="14" 
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ButtonBorder" 
                                                                Background="Transparent" 
                                                                CornerRadius="4">
                                                            <Grid>
                                                                <!-- Selection indicator -->
                                                                <Border x:Name="SelectionIndicator" 
                                                                        Width="4" 
                                                                        Height="30" 
                                                                        Background="{StaticResource AccentColor}" 
                                                                HorizontalAlignment="Left" 
                                                                Margin="8,0" 
                                                                Visibility="Collapsed"/>
                                                                
                                                                <ContentPresenter HorizontalAlignment="Stretch" 
                                                                                Margin="16,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" TargetName="ButtonBorder" Value="#313244"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" TargetName="ButtonBorder" Value="#313244"/>
                                                                <Setter Property="Visibility" TargetName="SelectionIndicator" Value="Visible"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Footer -->
                <Border Grid.Row="2" Padding="20" Background="#11111B">
                    <StackPanel>
                        <TextBlock Text="NetworkSharp 1.0" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="Ethernet verbunden" FontSize="11" Foreground="{StaticResource SuccessColor}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Border Grid.Column="1" Padding="32">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>
