<Window x:Class="NetworkSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkSharp"
        xmlns:views="clr-namespace:NetworkSharp.Views"
        mc:Ignorable="d"
        Title="NetworkSharp 2.2.2" Height="760" Width="1360" MinHeight="620" MinWidth="1040"
        Background="{StaticResource WindowGradient}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="258"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource BackgroundSidebar}" BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Logo/Title -->
                <Border Grid.Row="0" Padding="22,24" Background="#0A141D">
                    <Grid Width="196" Height="62" HorizontalAlignment="Left">
                        <TextBlock Text="#" FontSize="62" FontWeight="Bold" Foreground="{StaticResource AccentColor}"
                                   Opacity="0.22" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="2,-10,0,0"/>
                        <TextBlock Text="Network#" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentColor}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,11"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-8"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="NetworkSharp" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,17,0,0"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-8"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Border>
                
                <!-- Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NavigationItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="NavButton"
                                    Style="{StaticResource NavButtonStyle}"
                                        Click="NavButton_Click"
                                        Tag="{Binding Name}"
                                    Height="46"
                                    Margin="12,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Icon placeholder - would use proper icons in production -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Icon}" 
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="2,0,13,0"
                                                   VerticalAlignment="Center"/>
                                        
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding DisplayName}" 
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Footer -->
                <Border Grid.Row="2" Padding="22,18" Background="#0A141D" BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="NETWORKSHARP 2.2.2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="● SYSTEM ONLINE" FontSize="10" Foreground="{StaticResource SuccessColor}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Border Grid.Column="1" Padding="30,24,34,30" Background="{StaticResource WindowGradient}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="/" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="LIVE NETWORK TELEMETRY" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL NODE" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="● READY" FontSize="10" Foreground="{StaticResource SuccessColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#0D1822" BorderBrush="{StaticResource GridLine}" BorderThickness="1" CornerRadius="8" Padding="22">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <ContentControl x:Name="MainContent"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
