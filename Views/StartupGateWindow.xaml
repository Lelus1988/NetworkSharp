<Window x:Class="NetworkSharp.Views.StartupGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Background="{StaticResource WindowGradient}"
        Closing="Window_Closing">
    <Border Width="520" Padding="28" Background="{StaticResource BackgroundPanel}"
            BorderBrush="{StaticResource AccentDeep}" BorderThickness="1" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="NETWORKSHARP" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentColor}"/>
            <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,8,0,10"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource TextSecondary}"/>

            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource TextSecondary}">
                <Run Text="Mehr Informationen: "/>
                <Hyperlink Click="RepositoryLink_Click" Foreground="{StaticResource AccentColor}">
                    <Run Text="GitHub-Repository"/>
                </Hyperlink>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                <Button x:Name="AcceptButton" Style="{StaticResource ButtonStyle}"
                        MinWidth="190" Margin="0,0,10,0" Click="AcceptButton_Click"/>
                <Button x:Name="CloseButton" Style="{StaticResource ButtonStyle}"
                        Background="{StaticResource ErrorColor}" Foreground="#21080D"
                        MinWidth="120" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>