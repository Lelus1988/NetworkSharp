<UserControl x:Class="NetworkSharp.Views.PortScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetworkSharp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Port-Scanner" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Offene Dienste im eigenen Netzwerk finden" Style="{StaticResource SubtitleStyle}"/>
            
            <!-- Input Section -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Target Input -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Ziel" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" FontSize="14"/>
                        </StackPanel>
                        
                        <!-- Port Range Input -->
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Portbereich" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding StartPort}" Height="36" FontSize="14"/>
                        </StackPanel>
                        
                        <!-- Scan Button -->
                        <Button Grid.Column="2" Content="Scan starten" Style="{StaticResource ButtonStyle}" 
                                Height="36" VerticalAlignment="Bottom" Click="StartScan_Click"/>
                    </Grid>
                    
                    <!-- Port Range Selection -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Häufige" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0" Height="32"
                                Click="PortRange_Click" Tag="Häufige"/>
                        <Button Content="1-1024" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0" Height="32"
                                Click="PortRange_Click" Tag="1-1024"/>
                        <Button Content="Alle" Style="{StaticResource ButtonStyle}" Margin="0,0,0,0" Height="32"
                                Click="PortRange_Click" Tag="Alle"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Progress Section -->
            <Border Style="{StaticResource CardStyle}" x:Name="ProgressSection" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Scan läuft..." FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ScanProgress, StringFormat={}{0} von 1024 Ports}" 
                                   FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                    
                    <ProgressBar Height="8" Margin="0,12,0,0" Value="{Binding ScanProgress}" Maximum="1024"
                                 Foreground="{StaticResource AccentColor}" Background="#45475A"/>
                    
                    <Button Content="Stopp" Style="{StaticResource ButtonStyle}" Background="{StaticResource ErrorColor}" 
                            Foreground="#1E1E2E" HorizontalAlignment="Right" Margin="0,12,0,0" 
                            Width="100" Height="32" Click="StopScan_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Summary Cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Offen" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding OpenPorts}" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource SuccessColor}" Margin="0,4"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Gefiltert" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding FilteredPorts}" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource WarningColor}" Margin="0,4"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Geschlossen" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding ClosedPorts}" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextMuted}" Margin="0,4"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Results Table -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Table Header -->
                    <Grid Grid.Row="0" Height="40" Background="#45475A" Margin="-16,-16,-16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Port" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="Dienst" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Status" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Antwortzeit" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Table Content -->
                    <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScanResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="40" Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding Port}" FontSize="13" 
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" 
                                                   Margin="16,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Service}" FontSize="13" 
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="13" 
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ResponseTime, StringFormat={}{0} ms}" 
                                                   FontSize="13" Foreground="{StaticResource TextPrimary}" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
