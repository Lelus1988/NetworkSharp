<UserControl x:Class="NetworkSharp.Views.NetworkMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetworkSharp.Views"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Netzwerk-Monitor" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Ethernet - 1 Gbit/s - verbunden" Style="{StaticResource SubtitleStyle}"/>
            
            <!-- Data Overview Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Download Card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Download jetzt" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding CurrentDownloadSpeed, StringFormat={}{0:F1} Mbit/s}" 
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,4"/>
                        <TextBlock Text="{Binding AverageDownloadSpeedToday, StringFormat=Ø heute {0:F0} Mbit/s}" 
                                   FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>
                
                <!-- Upload Card -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Upload jetzt" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding CurrentUploadSpeed, StringFormat={}{0:F1} Mbit/s}" 
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,4"/>
                        <TextBlock Text="{Binding AverageUploadSpeedToday, StringFormat=Ø heute {0:F0} Mbit/s}" 
                                   FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>
                
                <!-- Transferred Card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Übertragen (7 Tage)" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding TotalDataTransferred7Days, StringFormat={}{0:F0} GB}" 
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,4"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                            <Run Text="↓ "/>
                            <Run Text="{Binding TotalDownload7Days, StringFormat={}{0:F0} GB}"/>
                            <Run Text=" ↑ "/>
                            <Run Text="{Binding TotalUpload7Days, StringFormat={}{0:F0} GB}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- Peak Card -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Spitzenwert" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding PeakDownloadSpeed, StringFormat={}{0:F0} Mbit/s}" 
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,4"/>
                        <TextBlock Text="{Binding PeakSpeedTimestamp, StringFormat='{}{0:ddd d.M., HH:mm}'}" 
                                   FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Time Range Selection -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="Live" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0" 
                        Click="LiveButton_Click"/>
                <Button Content="24 Std" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"
                        Click="Button24h_Click"/>
                <Button Content="7 Tage" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"
                        Click="Button7d_Click"/>
                <Button Content="30 Tage" Style="{StaticResource ButtonStyle}" Margin="0,0,0,0"
                        Click="Button30d_Click"/>
            </StackPanel>
            
            <!-- Data Rate Chart -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Datenrate im Zeitverlauf" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                    
                    <lvc:CartesianChart Height="250" Series="{Binding DownloadUploadSeries}" 
                                       LegendLocation="Top">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Zeit" Labels="Sa, So, Mo, Di, Mi, Do, Fr, Sa">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Mbit/s" LabelFormatter="{Binding Formatter}" MinValue="0">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="63"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>
            
            <!-- Daily Consumption Chart -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Verbrauch pro Tag (GB)" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                    
                    <lvc:CartesianChart Height="200" Series="{Binding DailyConsumptionSeries}">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Tag" Labels="Sa, So, Mo, Di, Mi, Do, Fr">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="GB" MinValue="0">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="20"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>
            
            <!-- Adapter Section -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Adapter" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                    
                    <!-- Ethernet Adapter -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ethernet" FontSize="14" FontWeight="Medium" 
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="verbunden" FontSize="12" Foreground="{StaticResource SuccessColor}"/>
                        </StackPanel>
                        
                        <ProgressBar Grid.Column="1" Width="100" Height="6" Value="100" 
                                     Foreground="{StaticResource SuccessColor}" Background="#45475A" 
                                     Margin="12,0,0,0"/>
                    </Grid>
                    
                    <!-- WLAN Adapter -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WLAN" FontSize="14" FontWeight="Medium" 
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="getrennt" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        
                        <ProgressBar Grid.Column="1" Width="100" Height="6" Value="0" 
                                     Foreground="{StaticResource TextMuted}" Background="#45475A" 
                                     Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
