<UserControl x:Class="NetworkSharp.Views.NetworkMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Farben -->
        <SolidColorBrush x:Key="CyanBrush" Color="#38E1D0"/>
        <SolidColorBrush x:Key="VioletBrush" Color="#A184FF"/>
        <SolidColorBrush x:Key="GridBrush" Color="#22344B"/>
        <LinearGradientBrush x:Key="CyanFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6638E1D0" Offset="0"/>
            <GradientStop Color="#0038E1D0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VioletFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#55A184FF" Offset="0"/>
            <GradientStop Color="#00A184FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Einblend-Animation (Fade + leichtes Hochgleiten), zweite Variante versetzt für Staffelung -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeInLate" BeginTime="0:0:0.15">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Zeitraum-Chips -->
        <Style x:Key="RangeChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8497AE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Padding="16,7" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B2B40"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26384F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Netzwerk-Monitor" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Ethernet - 1 Gbit/s - verbunden" Style="{StaticResource SubtitleStyle}"/>

            <!-- Kennzahlen -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Download jetzt" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding CurrentDownloadSpeed, StringFormat={}{0:F1} Mbit/s}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" Margin="0,4"/>
                        <TextBlock Text="{Binding AverageDownloadSpeedToday, StringFormat=Ø heute {0:F0} Mbit/s}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Upload jetzt" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding CurrentUploadSpeed, StringFormat={}{0:F1} Mbit/s}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource VioletBrush}" Margin="0,4"/>
                        <TextBlock Text="{Binding AverageUploadSpeedToday, StringFormat=Ø heute {0:F0} Mbit/s}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Übertragen (7 Tage)" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding TotalDataTransferred7Days, StringFormat={}{0:F0} GB}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                            <Run Text="↓ "/><Run Text="{Binding TotalDownload7Days, StringFormat={}{0:F0} GB}"/>
                            <Run Text="  ↑ "/><Run Text="{Binding TotalUpload7Days, StringFormat={}{0:F0} GB}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Spitzenwert" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding PeakDownloadSpeed, StringFormat={}{0:F0} Mbit/s}" FontSize="24" FontWeight="Bold" Foreground="#FFB547" Margin="0,4"/>
                        <TextBlock Text="{Binding PeakSpeedTimestamp, StringFormat='{}{0:ddd d.M., HH:mm}'}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Datenrate-Diagramm -->
            <Border Style="{StaticResource CardStyle}" Opacity="0">
                <Border.RenderTransform><TranslateTransform Y="16"/></Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                    </EventTrigger>
                </Border.Triggers>

                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Datenrate im Zeitverlauf" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>

                        <!-- Legende -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource CyanBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Download" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,16,0"/>
                            <Ellipse Width="9" Height="9" Fill="{StaticResource VioletBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Upload" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <!-- Zeitraum-Umschalter -->
                        <Border Grid.Column="2" Background="#0E1621" CornerRadius="9" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="Range" Content="Live" Style="{StaticResource RangeChip}" Command="{Binding SetRangeCommand}" CommandParameter="Live"/>
                                <RadioButton GroupName="Range" Content="24 Std" Style="{StaticResource RangeChip}" Command="{Binding SetRangeCommand}" CommandParameter="Day"/>
                                <RadioButton GroupName="Range" Content="7 Tage" Style="{StaticResource RangeChip}" Command="{Binding SetRangeCommand}" CommandParameter="Week" IsChecked="True"/>
                                <RadioButton GroupName="Range" Content="30 Tage" Style="{StaticResource RangeChip}" Command="{Binding SetRangeCommand}" CommandParameter="Month"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <lvc:CartesianChart Height="300" LegendLocation="None" Hoverable="True"
                                        AnimationsSpeed="0:0:0.6" DisableAnimations="False">
                        <lvc:CartesianChart.DataTooltip>
                            <lvc:DefaultTooltip Background="#1B2B40" Foreground="#E8EEF6" BulletSize="10"
                                                SelectionMode="SharedXValues" CornerRadius="8"/>
                        </lvc:CartesianChart.DataTooltip>

                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Download" Values="{Binding DownloadValues}"
                                            Stroke="{StaticResource CyanBrush}" Fill="{StaticResource CyanFill}"
                                            StrokeThickness="2.5" LineSmoothness="0.65"
                                            PointGeometry="{x:Null}" DataLabels="False"/>
                            <lvc:LineSeries Title="Upload" Values="{Binding UploadValues}"
                                            Stroke="{StaticResource VioletBrush}" Fill="{StaticResource VioletFill}"
                                            StrokeThickness="2.5" LineSmoothness="0.65"
                                            PointGeometry="{x:Null}" DataLabels="False"/>
                        </lvc:CartesianChart.Series>

                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding Labels}" FontSize="11" Foreground="{StaticResource TextMuted}">
                                <lvc:Axis.Separator><lvc:Separator Step="10" StrokeThickness="0"/></lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis LabelFormatter="{Binding Formatter}" MinValue="0" FontSize="11" Foreground="{StaticResource TextMuted}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator StrokeThickness="1" Stroke="{StaticResource GridBrush}" StrokeDashArray="3 5"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <!-- Verbrauch pro Tag (unverändert bis auf Einblendung) -->
            <Border Style="{StaticResource CardStyle}" Opacity="0">
                <Border.RenderTransform><TranslateTransform Y="16"/></Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeInLate}"/>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <TextBlock Text="Verbrauch pro Tag (GB)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                    <lvc:CartesianChart Height="200" Series="{Binding DailyConsumptionSeries}" AnimationsSpeed="0:0:0.6">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding DayLabels}" FontSize="11" Foreground="{StaticResource TextMuted}">
                                <lvc:Axis.Separator><lvc:Separator Step="1" StrokeThickness="0"/></lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis MinValue="0" FontSize="11" Foreground="{StaticResource TextMuted}">
                                <lvc:Axis.Separator><lvc:Separator StrokeThickness="1" Stroke="{StaticResource GridBrush}" StrokeDashArray="3 5"/></lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <!-- Adapter (unverändert) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Adapter" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ethernet" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="verbunden" FontSize="12" Foreground="{StaticResource SuccessColor}"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Width="100" Height="6" Value="100" Foreground="{StaticResource SuccessColor}" Background="#45475A" Margin="12,0,0,0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WLAN" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="getrennt" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Width="100" Height="6" Value="0" Foreground="{StaticResource TextMuted}" Background="#45475A" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
