<UserControl x:Class="NetworkSharp.Views.WlanProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetworkSharp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="WLAN-Profile" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Auf diesem PC gespeicherte Netzwerke" Style="{StaticResource SubtitleStyle}"/>
            
            <!-- Warning Message -->
            <Border Style="{StaticResource CardStyle}" Background="#313244" BorderBrush="{StaticResource WarningColor}" 
                    BorderThickness="1" Margin="0,0,0,16">
                <TextBlock Text="Es werden nur Profile angezeigt, die auf diesem PC gespeichert sind. Zum Anzeigen ist eine Bestätigung als Administrator nötig." 
                           FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </Border>
            
            <!-- Main Content Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Profile List -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Gespeicherte Profile" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                        
                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="60" Margin="0,0,0,8" Background="#45475A" CornerRadius="4"
                                                Padding="12" Cursor="Hand" MouseLeftButtonUp="Profile_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" 
                                                               Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding SecurityType}" FontSize="12" 
                                                               Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                
                                                <!-- Signal Strength Indicator -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Rectangle Width="4" Height="8" Fill="{Binding SignalStrength, Converter={StaticResource SignalStrengthToColorConverter}}" 
                                                               Margin="1" RadiusX="1" RadiusY="1"/>
                                                    <Rectangle Width="4" Height="12" Fill="{Binding SignalStrength, Converter={StaticResource SignalStrengthToColorConverter}}" 
                                                               Margin="1" RadiusX="1" RadiusY="1"/>
                                                    <Rectangle Width="4" Height="16" Fill="{Binding SignalStrength, Converter={StaticResource SignalStrengthToColorConverter}}" 
                                                               Margin="1" RadiusX="1" RadiusY="1"/>
                                                    <Rectangle Width="4" Height="20" Fill="{Binding SignalStrength, Converter={StaticResource SignalStrengthToColorConverter}}" 
                                                               Margin="1" RadiusX="1" RadiusY="1"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Selection Highlight -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="{Binding DataContext.SelectedProfile.Name, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
                <!-- Profile Details -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0"
                        Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Profildetails" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                        
                        <!-- Profile Name -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Profilname" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
                        </StackPanel>
                        
                        <!-- Security Type -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Sicherheit" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,4">
                                <Run Text="{Binding SelectedProfile.SecurityType}"/>
                                <Run Text=" - "/>
                                <Run Text="Automatisch verbinden"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Password -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Passwort" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <PasswordBox Grid.Column="0" Height="36" Padding="8" 
                                            Background="#45475A" Foreground="{StaticResource TextPrimary}"
                                            BorderThickness="0" FontSize="14" IsEnabled="{Binding ShowPassword, Converter={StaticResource InverseBooleanConverter}}"
                                            PasswordChanged="PasswordBox_PasswordChanged"/>
                                
                                <TextBox Grid.Column="0" Text="{Binding Password}" Height="36" Padding="8" 
                                         Background="#45475A" Foreground="{StaticResource TextPrimary}"
                                         BorderThickness="0" FontSize="14" IsReadOnly="True"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                
                                <Button Grid.Column="1" Content="Anzeigen" Style="{StaticResource ButtonStyle}" 
                                        Height="36" Width="80" Margin="8,0,0,0" Click="ShowPassword_Click"
                                        Visibility="{Binding ShowPassword, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                
                                <Button Grid.Column="1" Content="Verbergen" Style="{StaticResource ButtonStyle}" 
                                        Height="36" Width="80" Margin="8,0,0,0" Click="HidePassword_Click"
                                        Visibility="{Binding ShowPassword, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                
                                <Button Grid.Column="2" Content="Kopieren" Style="{StaticResource ButtonStyle}" 
                                        Height="36" Width="80" Margin="8,0,0,0" Click="CopyPassword_Click"/>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Last Connected -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Zuletzt verbunden" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding SelectedProfile.LastConnected, StringFormat='{}{0:dddd, HH:mm}'}" 
                                       FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
                        </StackPanel>
                        
                        <!-- Signal Strength -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Signalstärke" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <ProgressBar Height="8" Margin="0,4" Value="{Binding SelectedProfile.SignalStrength}" 
                                         Maximum="100" Foreground="{Binding SelectedProfile.SignalStrength, Converter={StaticResource SignalStrengthToColorConverter}}" 
                                         Background="#45475A"/>
                        </StackPanel>
                        
                        <!-- Delete Button -->
                        <Button Content="Profil löschen" Style="{StaticResource ButtonStyle}" 
                                Background="{StaticResource ErrorColor}" Foreground="#1E1E2E"
                                Height="36" Click="DeleteProfile_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
